# UniHelp - Environment Variables (Template)
# Copy this file to .env and fill in the values.

# Application Environment (set to 'production' on live deployment)
APP_ENV=development

# Database Configuration
DB_HOST=mysql
DB_NAME=unihelp
DB_USER=root
DB_PASS=

# Docker MySQL settings (read by docker-compose.yml — keep in .env, never in compose file)
MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=yes

# AI & External APIs
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# RAG Backend
RAG_API_URL=http://localhost:8000/api/chat
RAG_STUDENT_TOKEN=your_jwt_token_here

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="UniHelp Authenticator"
