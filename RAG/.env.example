PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=us-east1-aws
PINECONE_INDEX=hybrid-search
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-2603
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-embedding-8b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=default

# MySQL (for chatbot document registry)
DB_HOST=127.0.0.1
DB_NAME=unihelp
DB_USER=root
DB_PASS=

# Rate Limiting
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DOCUMENTS=60/minute
RATE_LIMIT_DELETE=10/minute

# Input Validation
MAX_QUESTION_LENGTH=5000
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_REQUEST=10

# Security
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256

# CORS & Headers
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://unicopy-web

LOG_LEVEL=INFO
